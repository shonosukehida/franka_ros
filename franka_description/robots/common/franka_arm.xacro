<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:macro name="franka_arm" params="arm_id:='panda' connected_to:='' xyz:='0 0 0' rpy:='0 0 0' gazebo:=false safety_distance:=0">
    <xacro:unless value="${not connected_to}">
      <joint name="${arm_id}_joint_${connected_to}" type="fixed">
        <parent link="${connected_to}"/>
        <child link="${arm_id}_link0"/>
        <origin rpy="${rpy}" xyz="${xyz}"/>
      </joint>
    </xacro:unless>

    <!-- 以下、各関節定義 -->

    <joint name="${arm_id}_joint1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.333"/>
      <parent link="${arm_id}_link0"/>
      <child link="${arm_id}_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8973" upper="2.8973" velocity="2.175" effort="87.0"/>
    </joint>

    <joint name="${arm_id}_joint2" type="revolute">
      <origin rpy="-1.5707963 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link1"/>
      <child link="${arm_id}_link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.7628" upper="1.7628" velocity="2.175" effort="87.0"/>
    </joint>

    <joint name="${arm_id}_joint3" type="revolute">
      <origin rpy="1.5707963 0 0" xyz="0 -0.316 0"/>
      <parent link="${arm_id}_link2"/>
      <child link="${arm_id}_link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8973" upper="2.8973" velocity="2.175" effort="87.0"/>
    </joint>

    <joint name="${arm_id}_joint4" type="revolute">
      <origin rpy="1.5707963 0 0" xyz="0.0825 0 0"/>
      <parent link="${arm_id}_link3"/>
      <child link="${arm_id}_link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.0718" upper="-0.0698" velocity="2.175" effort="87.0"/>
    </joint>

    <joint name="${arm_id}_joint5" type="revolute">
      <origin rpy="-1.5707963 0 0" xyz="-0.0825 0.384 0"/>
      <parent link="${arm_id}_link4"/>
      <child link="${arm_id}_link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8973" upper="2.8973" velocity="2.61" effort="12.0"/>
    </joint>

    <joint name="${arm_id}_joint6" type="revolute">
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <parent link="${arm_id}_link5"/>
      <child link="${arm_id}_link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.0175" upper="3.7525" velocity="2.61" effort="12.0"/>
    </joint>

    <joint name="${arm_id}_joint7" type="revolute">
      <origin rpy="1.5707963 0 0" xyz="0.088 0 0"/>
      <parent link="${arm_id}_link6"/>
      <child link="${arm_id}_link7"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.8973" upper="2.8973" velocity="2.61" effort="12.0"/>
    </joint>

    <link name="${arm_id}_link8"/>
    <joint name="${arm_id}_joint8" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.107"/>
      <parent link="${arm_id}_link7"/>
      <child link="${arm_id}_link8"/>
    </joint>

  </xacro:macro>
</robot>
